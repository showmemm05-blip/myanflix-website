# Copy to .env before running docker compose: cp .env.example .env
# (Separate from .env.local, which `next dev`/`next start` use directly —
# this one only feeds docker-compose.yml's build arg.)

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
PORT=3003

# "Continue with Google" — the OAuth 2.0 Web client ID from Google Cloud
# Console. Must equal backend GOOGLE_CLIENT_ID. Baked into the bundle at build
# time like the API URL above (rebuild after changing). Empty = button hidden.
# For `npm run dev`, put the same line in .env.local.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Security headers (next.config.ts) — both fixed at build time, both optional.
# CSP_ENFORCE=1 makes the Content-Security-Policy block anything not on its
# allow list; empty (default) sends that list as Report-Only, so the browser
# only logs violations in the console (framing, plugins, <base> and form
# hijacking are blocked either way). Flip to 1 once a deployment shows none.
CSP_ENFORCE=
# Extra origins the browser may load posters/video/API data from, space
# separated — only needed when they are not served from the API host on :8080.
CSP_EXTRA_ORIGINS=
